#!/sbin/openrc-run

name="ZJMF database queue worker (@QUEUE_NAME@)"
description="$name"
directory="@PROJECT_ROOT@"
command="@PHP_BIN@"
command_args="@PROJECT_ROOT@/think queue:work --daemon --queue @QUEUE_NAME@ --delay 10 --sleep 2 --tries 3 --memory 128"
command_user="@RUN_USER@"
supervisor=supervise-daemon
respawn_delay=3
respawn_max=3
respawn_period=10

depend()
{
	need net
	after mysql mariadb
}
